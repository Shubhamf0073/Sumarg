{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://previa.local/protocol/command.v1.json",
  "title": "Command v1 (cloud -> device)",
  "type": "object",
  "required": ["v", "id", "type"],
  "properties": {
    "v": { "const": 1 },
    "id": { "type": "string", "maxLength": 40 },
    "type": { "enum": ["REBOOT", "PING", "BUZZER_TEST", "REQUEST_STATUS", "SET_SEQ_FLOOR", "RESEND", "CAPTURE", "OTA", "FACTORY_RESET"] },
    "exp": { "type": "integer" },
    "p": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "OTA" } } },
      "then": { "required": ["p"], "properties": { "p": { "required": ["version", "url", "sha256", "sig", "size"],
        "properties": { "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } } } },
    { "if": { "properties": { "type": { "const": "CAPTURE" } } },
      "then": { "required": ["p"], "properties": { "p": { "required": ["what"], "properties": { "what": { "enum": ["weight", "fuel", "imu_rest"] }, "n": { "type": "integer", "minimum": 1, "maximum": 2000 } } } } } },
    { "if": { "properties": { "type": { "const": "FACTORY_RESET" } } },
      "then": { "required": ["p"], "properties": { "p": { "required": ["confirm"] } } } }
  ]
}
