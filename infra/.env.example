# Sumarg — production app environment (api, worker and ingest containers, and compose interpolation).
# Copied to /srv/schoolfleet/compose/.env by bootstrap.sh, which fills __GENERATE__ / __GENERATE_KEY__; chmod 600.
# Database superuser and schema-owner passwords are NOT here — they live in db.env.
# Every setting read by the Go config structs (platform/config Base + the Sumarg config, M0.2) must appear here
# or in db.env. DATABASE_URL / PLATFORM_DATABASE_URL are assembled by docker-compose.yml from DB_* below.

# ── App ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_DOMAIN=sumarg.previasoftwares.com
LOG_LEVEL=info
LOG_FORMAT=json
# Session lifetimes (portal 12 h idle / 7 days, apps 90 days renewed on use) are fixed in code and SQL, not set here
# (docs/05 §10). Previa admin passkey sessions: absolute hours, 1–24 (docs/02 A24).
ADMIN_SESSION_HOURS=12
# The Nginx hop as seen inside the API container: the compose network's gateway (infra/docker-compose.yml). Only
# from this peer is X-Forwarded-For believed (per-IP sign-in limits, session audit). Required outside local.
TRUSTED_PROXIES=172.30.231.1/32
FILES_DIR=/data/files
# 32-byte key (hex): OTP HMAC and login tickets. Losing it only invalidates live OTPs. Keep it in the password manager.
SECRETS_KEY=__GENERATE_KEY__

# ── Images / host wiring (read by docker compose) ────────────────────
API_IMAGE=ghcr.io/your-org/schoolfleet-backend
IMAGE_TAG=v0.1.0
API_PORT=8720
WEB_GID=33
DATA_DIR=/srv/schoolfleet/data

# ── Database (app connects as sf_app; admin API + worker as sf_platform) ─
DB_HOST=db
DB_PORT=5432
DB_NAME=schoolfleet
DB_APP_PASSWORD=__GENERATE__
DB_PLATFORM_PASSWORD=__GENERATE__
DB_MAX_CONNS=8                 # api: sf_app pool (docs/02 §5)
PLATFORM_DB_MAX_CONNS=3        # api + worker: sf_platform pool each
DB_STATEMENT_TIMEOUT_MS=10000

# ── Bus units: MQTT/TLS ingest (docs/13) ─────────────────────────────
MQTT_HOST=devices.sumarg.previasoftwares.com   # DNS-only (grey cloud) A record → this server
MQTT_PORT=8883
MQTT_CERT=/certs/fullchain.pem                       # Let's Encrypt via certbot on the host (docs/06 §2)
MQTT_KEY=/certs/privkey.pem
MQTT_MAX_UNITS=2000
FIRMWARE_DIR=/data/files/firmware                    # signed OTA images served over HTTPS by Nginx

# ── Google Maps Platform (docs/02 A12) ───────────────────────────────
# Browser key: referrer-restricted to https://sumarg.previasoftwares.com/*, Maps JavaScript API only (portal).
# Server key:  IP-restricted to this server, Routes API + Geocoding API only (route setup, never per trip).
# The mobile apps carry their own Android/iOS-restricted keys (Maps SDK, unlimited at no charge).
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ── Push notifications: Firebase Cloud Messaging HTTP v1 (Android + iOS via APNs) ─
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=/data/secrets/fcm-service-account.json   # chmod 600, outside the image

# ── SMS (parent OTP; optional fallback alerts). DLT-registered sender + templates required ─
SMS_PROVIDER=msg91             # msg91 | stub (dev); 2factor is not built yet
SMS_API_KEY=
SMS_SENDER_ID=                 # DLT header, e.g. PREVIA (docs/15 §5)
SMS_DLT_PE_ID=                 # DLT Principal Entity ID
SMS_DLT_TEMPLATE_OTP=          # DLT content template IDs (Service Implicit); msg91: its template id, ##var1## = code, ##var2## = school
SMS_DLT_TEMPLATE_INVITE=
SMS_DLT_TEMPLATE_BOARDED=
SMS_DLT_TEMPLATE_DROPPED=
SMS_DLT_TEMPLATE_DELAY=

# ── App-store review login for the demo school only (docs/15 §8, docs/07 S17). Off in normal operation ─
DEMO_REVIEW_LOGIN=off          # on only while a store review is pending
DEMO_REVIEW_MOBILES=           # comma-separated review mobiles, accepted only with school code "demo"
DEMO_REVIEW_OTP=               # fixed 6-digit code for those mobiles; rotate after each review

# ── Previa details printed on subscription invoices ───────────
PREVIA_LEGAL_NAME=Previa Softwares
PREVIA_GSTIN=
PREVIA_STATE_CODE=24
PREVIA_ADDRESS=
PREVIA_SAC=
PREVIA_BANK_DETAILS=

# ── Backups (read by scripts/backup.sh on the host, not by the app) ──
BACKUP_DIR=/srv/schoolfleet/backups
RCLONE_REMOTE=
BACKUP_PING_URL=
