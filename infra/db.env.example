# Sumarg — database container secrets. Copied to /srv/schoolfleet/compose/db.env by bootstrap.sh; chmod 600.
# Only the db container reads this file. deploy.sh passes DB_OWNER_PASSWORD to the one-off migration
# container; backup/restore use the superuser through the container's local socket.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE__
SF_DB=schoolfleet
DB_OWNER_PASSWORD=__GENERATE__
# The next two must equal the values in .env (bootstrap.sh writes the same values to both files).
DB_APP_PASSWORD=__SAME_AS_ENV__
DB_PLATFORM_PASSWORD=__SAME_AS_ENV__
