    "test": "jest --ci"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-router": "~6.0.0",
    "expo-notifications": "~0.32.0",
    "expo-secure-store": "~15.0.0",
    "expo-localization": "~17.0.0",
    "expo-location": "~19.0.0",
    "expo-camera": "~17.0.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-native-maps": "1.20.1",
    "@tanstack/react-query": "^5.90.0",
    "openapi-fetch": "^0.15.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "openapi-typescript": "^7.10.0",
    "@biomejs/biome": "^2.3.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "@types/react": "~19.1.0"
  }
}
